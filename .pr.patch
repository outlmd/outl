+/// The title Roam gives the daily note of `d` (`March 19th, 2024`).
+fn roam_daily_title(d: chrono::NaiveDate) -> String {
+    use chrono::Datelike;
+    let day = d.day();
+    let suffix = match (day % 10, day % 100) {
+        (_, 11..=13) => "th",
+        (1, _) => "st",
+        (2, _) => "nd",
+        (3, _) => "rd",
+        _ => "th",
+    };
+    format!("{} {day}{suffix}, {}", d.format("%B"), d.year())
+}
