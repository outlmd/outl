+/// Advance the fence state over one disk line and say whether that line
+/// is the **body** of a fenced code block (where the renderer writes the
+/// block's text verbatim, bullets included).
+///
+/// Mirrors [`crate::fence`]: an opener is a fence marker on a block's
+/// first line (`- ```yaml`, body one level deeper) or on a continuation
+/// line (body at the same level); the fence ends on its own closer at
+/// the body level, or on a non-blank line outdented below the body.
+fn track_fence(fence: &mut Option<(&'static str, usize)>, raw: &str) -> bool {
+    let trimmed = raw.trim();
+    let indent = crate::parse::leading_indent(raw);
+    if let Some((marker, body_indent)) = *fence {
+        if trimmed.is_empty() {
+            return true;
+        }
+        if indent < body_indent {
+            *fence = None;
+        } else {
+            let fence_char = marker.chars().next().unwrap_or('`');
+            let closes = indent == body_indent
+                && trimmed.starts_with(marker)
+                && trimmed.chars().skip(marker.len()).all(|c| c == fence_char);
+            if closes {
+                *fence = None;
+            }
+            return true;
+        }
+    }
+    let (content, body_indent) = match trimmed.strip_prefix("- ") {
+        Some(rest) => (rest.trim_start(), indent + 1),
+        None => (trimmed, indent),
+    };
+    if let Some(marker) = crate::fence::fence_marker(content) {
+        *fence = Some((marker, body_indent));
+    }
+    false
+}
